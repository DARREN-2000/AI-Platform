# Copy to .env and adjust. Everything defaults to offline so it runs with no keys.

# Agent provider: rules (offline) | openai | anthropic | openrouter
CHALLENGE_PROVIDER=rules
# Optional model override (e.g. meta-llama/llama-3.1-8b-instruct:free)
CHALLENGE_MODEL=
CHALLENGE_MAX_STEPS=6

# Eval judge provider: mock (offline) | openai | anthropic | openrouter
CHALLENGE_EVAL_PROVIDER=mock
CHALLENGE_DATASET=data/golden.jsonl

# Persistence: leave empty for in-memory; set to a DSN for PostgreSQL
# e.g. postgresql://user:pass@localhost:5432/challenge
DATABASE_URL=

# Real-provider keys (NEVER commit real values)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_BASE_URL=
