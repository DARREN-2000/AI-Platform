# ---- LLM ----
# provider: openai | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# ---- GitHub ----
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_REPO=owner/repo

# ---- Notion (optional — leave blank to disable Notion sync) ----
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ---- Scheduling ----
REMINDER_INTERVAL_HOURS=24
STALE_PR_THRESHOLD_DAYS=7
STALE_ISSUE_THRESHOLD_DAYS=14

# ---- Persistence ----
DB_PATH=automation.db

# ---- Server / logging ----
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
JSON_LOGS=true
