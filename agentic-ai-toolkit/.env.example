# Provider selection: rules (offline default) | openai | anthropic | openrouter
AGENTIC_PROVIDER=rules
# Optional model name override (uses a sensible default per provider otherwise).
# OpenRouter free model example: meta-llama/llama-3.1-8b-instruct:free
AGENTIC_MODEL=
# API keys (only needed for the openai / anthropic / openrouter providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenRouter (OpenAI-compatible). Set your key here; do NOT commit a real key.
OPENROUTER_API_KEY=
# Override the OpenAI-compatible base URL (the openrouter provider sets this).
OPENAI_BASE_URL=
# Optional: path to a newline-delimited docs file used for RAG
AGENTIC_DOCS_PATH=
# HTTP port for the service
PORT=8000
