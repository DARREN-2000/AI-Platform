# Provider selection: rules (offline default) | openai | anthropic
AGENTIC_PROVIDER=rules
# Optional model name override (uses a sensible default per provider otherwise)
AGENTIC_MODEL=
# API keys (only needed for the openai / anthropic providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: path to a newline-delimited docs file used for RAG
AGENTIC_DOCS_PATH=
# HTTP port for the service
PORT=8000
