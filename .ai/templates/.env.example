# LLM providers (configure >=2 for fallback/benchmarking)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Observability (optional; tracing no-ops if unset)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Database
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# Eval gate
EVAL_THRESHOLD=0.8
